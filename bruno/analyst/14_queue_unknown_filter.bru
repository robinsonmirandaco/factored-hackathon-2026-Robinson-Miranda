meta {
  name: an unknown filter is 422
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/queue?filter=everything
  body: none
  auth: bearer
}

auth:bearer {
  token: {{analystToken}}
}

tests {
  test("422 validation_error", function() {
    expect(res.getStatus()).to.equal(422);
    expect(res.getBody().error_code).to.equal("validation_error");
  });
}
