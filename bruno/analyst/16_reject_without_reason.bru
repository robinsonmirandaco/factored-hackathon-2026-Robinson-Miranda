meta {
  name: TRZ-27 CA4 a rejection without a reason is 400
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/cases/{{dossierCase}}/decision
  body: json
  auth: bearer
}

auth:bearer {
  token: {{analystToken}}
}

body:json {
  {"decision": "reject"}
}

tests {
  test("400 reason_required", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error_code).to.equal("reason_required");
  });
}
