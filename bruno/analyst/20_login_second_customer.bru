meta {
  name: log in as the customer of Colombia
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/auth/otp/verify
  body: json
  auth: none
}

body:json {
  {"document_type": "CC", "document_number": "SYN0000004", "code": "{{demoCode}}"}
}

script:post-response {
  bru.setVar("colombiaToken", res.getBody().access_token);
}

tests {
  test("200 customer session", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().role).to.equal("customer");
  });
}
