meta {
  name: TRZ-28 CA2 the answer is in the dossier with its question
  type: http
  seq: 32
}

get {
  url: {{baseUrl}}/cases/{{infoCase}}/dossier
  body: none
  auth: bearer
}

auth:bearer {
  token: {{analystToken}}
}

tests {
  test("the question with its answer, from info_requests", function() {
    expect(res.getStatus()).to.equal(200);
    const [x] = res.getBody().info_exchanges;
    expect(x.question).to.equal("¿Hiciste alguna compra en Mercado Libre ese día?");
    expect(x.answer).to.equal("No, esa compra no la hice.");
    expect(x.source.table).to.equal("info_requests");
    expect(res.getBody().later_messages).to.eql([]);
  });
}
