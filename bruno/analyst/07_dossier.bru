meta {
  name: CA1 to CA4 the dossier with every fact and its source
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/cases/{{dossierCase}}/dossier
  body: none
  auth: bearer
}

auth:bearer {
  token: {{analystToken}}
}

tests {
  test("complete and sourced", function() {
    const d = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(d.case_kind).to.equal("escalation");
    // "None of the options" leaves no charge; after the dispute folder the customer also has
    // an open dispute, which the policy checks first. Either rule hands the case over.
    expect(["escalate.conformal_set_empty", "escalate.open_dispute_last_90d"]).to.include(
      d.policy_rule_triggered.rule
    );
    expect(d.request_summary).to.be.a("string").and.not.empty;
    expect(d.verified_facts).to.not.be.empty;
    d.verified_facts.concat(d.evidence).forEach(function(f) {
      expect(f.source.table).to.not.be.empty;
      expect(f.source.id).to.not.be.empty;
    });
    d.extraction.forEach(function(c) {
      expect(c.evidence).to.not.be.empty;
    });
    expect(d.identification.top).to.not.be.empty;
    expect(d).to.not.have.property("transcript");
  });
}
