meta {
  name: the second charge goes to a person
  type: http
  seq: 27
}

post {
  url: {{baseUrl}}/chat
  body: json
  auth: bearer
}

auth:bearer {
  token: {{colombiaToken}}
}

body:json {
  {"message": "Sigo sin reconocerlo", "case_id": "{{infoCase}}", "recognition": "not_recognized"}
}

tests {
  test("escalated", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().outcome).to.equal("escalated");
  });
}
