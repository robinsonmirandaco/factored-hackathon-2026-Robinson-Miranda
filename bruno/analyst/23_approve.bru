meta {
  name: TRZ-27 CA3 approving registers the dispute verified, without the card block
  type: http
  seq: 23
}

post {
  url: {{baseUrl}}/cases/{{approveCase}}/decision
  body: json
  auth: bearer
}

auth:bearer {
  token: {{analystToken}}
}

body:json {
  {"decision": "approve"}
}

script:post-response {
  bru.setVar("approvedFolio", res.getBody().dispute_folio);
}

tests {
  test("200 approved with a folio, block not executed", function() {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.status).to.equal("approved");
    expect(body.dispute_folio).to.match(/^DSP-2026-\d{5}$/);
    expect(body.block_not_executed).to.equal(true);
  });
}
