meta {
  name: the same charge in a new case
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/chat
  body: json
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

body:json {
  {"message": "No reconozco un cargo de 87.55 dólares en Netflix"}
}

script:post-response {
  bru.setVar("disputeCase", res.getBody().case_id);
}

tests {
  test("recognizing again", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().outcome).to.equal("recognizing");
  });
}
