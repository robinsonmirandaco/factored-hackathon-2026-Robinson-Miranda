meta {
  name: claim status in Portuguese
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/chat
  body: json
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

body:json {
  {"message": "Como vai minha reclamação?"}
}

tests {
  test("read only: informed, or a list when there are several claims", function() {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.intent).to.equal("claim_status");
    expect(["informed", "identifying"]).to.include(body.outcome);
    expect(body.autonomy_level).to.equal("L0");
    expect(body.actions_taken).to.eql([]);
    if (body.outcome === "identifying") {
      expect(body.claims.length).to.be.at.least(2);
    }
  });
}
