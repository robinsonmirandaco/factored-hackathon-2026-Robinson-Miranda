post {
  url: {{baseUrl}}/me/notifications/{{noteId}}/read
  body: none
  auth: bearer
}

auth:bearer {
  token: {{supervisionToken}}
}

tests {
  test("200 read", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().read).to.equal(true);
  });
}
