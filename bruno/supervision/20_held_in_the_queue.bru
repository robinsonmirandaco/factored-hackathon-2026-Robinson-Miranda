meta {
  name: TRZ-35 CA2 the queue says automation is off
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/queue
  body: none
  auth: bearer
}

auth:bearer {
  token: {{analystToken}}
}

tests {
  test("reason escalate.automation_disabled", function() {
    expect(res.getStatus()).to.equal(200);
    const item = res.getBody().items.find((i) => i.case_id === bru.getVar("heldCase"));
    expect(item.reason).to.equal("escalate.automation_disabled");
  });
}
