meta {
  name: TRZ-38 the same key resets once
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/demo/reset
  body: none
  auth: bearer
}

headers {
  idempotency-key: {{resetKey}}
}

auth:bearer {
  token: {{analystToken}}
}

tests {
  test("200 with the stored answer", function() {
    expect(res.getStatus()).to.equal(200);
    expect(JSON.stringify(res.getBody())).to.equal(bru.getVar("resetBody"));
  });
}
