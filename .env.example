# TRAZO · variables de entorno
# Copia este archivo a .env y completa los valores. .env NUNCA va a git.
# Los comentarios van en su propia línea: algunas herramientas no quitan
# los comentarios al final de un valor y los toman como parte del valor.

# --- General ---
# local | ci | prod
APP_ENV=local
LOG_LEVEL=INFO
# Semilla fija para pipeline, splits, muestra de auditoría y evaluación
SEED=42
# Railway define PORT en producción; en local se usa este valor
PORT=8000
# Puerto publicado de la API en tu máquina. Cámbialo, como DB_PORT, para correr un segundo
# proyecto a la vez (docker compose -p verify) sin chocar con el proyecto por defecto.
API_PORT=8000

# --- Reloj simulado (TRZ-24) ---
# Fecha "de hoy" del sistema: último día del dataset
TRAZO_NOW=2026-06-17T23:59:00

# --- Datos (AWS S3, solo lectura) ---
# Credenciales en el perfil local de AWS (aws configure --profile factored)
AWS_PROFILE=factored
AWS_REGION=us-east-2
S3_BUCKET=factored-datathon-2026-s3-157725502942-us-east-2-an
S3_PREFIX=data/
# Bronce, plata y oro locales (fuera de git)
DATA_DIR=./data
# Ventana de reprocesamiento (TRZ-04): las particiones de los últimos N días se leen de nuevo
PIPELINE_REPROCESS_DAYS=7

# --- Base de datos ---
# Dueño del esquema: solo lo usan las migraciones, las semillas y las fixtures de prueba.
POSTGRES_USER=trazo
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=trazo
# Puerto publicado en tu máquina. Cámbialo para correr un segundo proyecto a la vez
# (docker compose -p verify) sin chocar con el proyecto por defecto.
DB_PORT=5432
# Rol de la aplicación. La API se conecta solo como trazo_app, que no es superusuario ni
# dueño de las tablas, para que RLS siempre aplique. make migrate le pone esta contraseña.
APP_DB_PASSWORD=cambia-esto-tambien
# Desde tu máquina (pruebas, scripts). Dentro de docker compose los servicios usan el host
# "db": el compose sobrescribe ambas URLs.
# El esquema postgresql+psycopg:// usa psycopg 3, el driver instalado.
DATABASE_URL=postgresql+psycopg://trazo_app:cambia-esto-tambien@localhost:5432/trazo
ADMIN_DATABASE_URL=postgresql+psycopg://trazo:cambia-esto@localhost:5432/trazo
# Despliegue en Supabase: usa la cadena del pooler (funciona por IPv4)
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@<pooler-host>:5432/postgres

# --- Datos personales (TRZ-07) ---
# Clave del HMAC-SHA256 que reemplaza el número de documento en customers; el número nunca se
# guarda. Sin ella no se pueden cargar clientes. Genera una con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
DOCUMENT_HASH_KEY=

# --- LLM (consola de la API de Claude, no la suscripción de Claude) ---
ANTHROPIC_API_KEY=
LLM_MODEL_PRIMARY=claude-haiku-4-5-20251001
LLM_MODEL_COMPARE=claude-sonnet-5
LLM_TIMEOUT_SECONDS=5
LLM_MAX_RETRIES=1
# Prompt versionado de la comprensión y precio del modelo principal (USD por millón de tokens)
LLM_COMPREHENSION_PROMPT_PATH=config/prompts/comprehension.yaml
LLM_PRICE_INPUT_PER_MTOK=1.0
LLM_PRICE_OUTPUT_PER_MTOK=5.0
# false fuerza el camino determinístico de respaldo (reglas y plantillas)
LLM_ENABLED=true
# true en CI: usa el LLM simulado
LLM_MOCK=false

# --- Autenticación (TRZ-09) ---
# Firma de las sesiones. make init genera una; la API no arranca con menos de 32 caracteres.
JWT_SECRET=genera-uno-largo-y-aleatorio
JWT_ALGORITHM=HS256
# Sesión: vence tras 15 minutos sin uso y, en cualquier caso, 2 horas después de entrar.
# Se miden con el reloj real, no con TRAZO_NOW.
SESSION_IDLE_MINUTES=15
SESSION_MAX_MINUTES=120
# Código de un solo uso: vigencia, intentos fallidos antes del bloqueo y duración del bloqueo
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_LOCK_MINUTES=15
# Solicitudes de código por documento en cada ventana (se cuentan exista o no el documento)
OTP_REQUEST_LIMIT=5
OTP_REQUEST_WINDOW_MINUTES=15
# Solicitudes por dirección IP a cada endpoint de entrada en cada ventana (TRZ-40)
IP_REQUEST_LIMIT=30
IP_REQUEST_WINDOW_MINUTES=15
# Proxies delante de la API que agregan su entrada a X-Forwarded-For: 0 en local y CI (se usa
# la IP del socket), 1 en Railway (la entrada que agrega su borde). Nunca se usa la de la izquierda.
TRUSTED_PROXY_HOPS=0

# --- Modo demo (TRZ-09 CA3, TRZ-38) ---
# Habilita el código OTP fijo, el endpoint de reinicio y el estado sembrado.
# Siempre false en la evaluación.
DEMO_MODE=false
DEMO_OTP_CODE=482913
# Sin modo demo, el código es aleatorio y solo aparece en el log cuando APP_ENV=local.
# Credenciales de prueba de la analista del demo. make init genera la contraseña; sin
# contraseña ninguna analista puede entrar.
ANALYST_DEMO_USER=analista.demo
ANALYST_DEMO_PASSWORD=cambia-esto

# --- Política y autonomía ---
POLICY_PATH=config/policy.yaml

# --- Correo (opcional, apagado por defecto, TRZ-33) ---
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
# Solo tu bandeja de prueba, nunca correos del dataset
EMAIL_TEST_INBOX=

# --- Retención (TRZ-41) ---
CONVERSATION_RETENTION_DAYS=90
