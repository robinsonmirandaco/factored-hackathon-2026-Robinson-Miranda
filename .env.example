# TRAZO · variables de entorno
# Copia este archivo a .env y completa los valores. .env NUNCA va a git.
# Los comentarios van en su propia línea: algunas herramientas no quitan
# los comentarios al final de un valor y los toman como parte del valor.

# --- General ---
# local | ci | prod
APP_ENV=local
LOG_LEVEL=INFO
# Semilla fija para pipeline, splits, muestra de auditoría y evaluación
SEED=42
# Railway define PORT en producción; en local se usa este valor
PORT=8000

# --- Reloj simulado (TRZ-24) ---
# Fecha "de hoy" del sistema: último día del dataset
TRAZO_NOW=2026-06-17T23:59:00

# --- Datos (AWS S3, solo lectura) ---
# Credenciales en el perfil local de AWS (aws configure --profile factored)
AWS_PROFILE=factored
AWS_REGION=us-east-2
S3_BUCKET=factored-datathon-2026-s3-157725502942-us-east-2-an
S3_PREFIX=data/
# Bronce, plata y oro locales (fuera de git)
DATA_DIR=./data
# Ventana de reprocesamiento (TRZ-04): las particiones de los últimos N días se leen de nuevo
PIPELINE_REPROCESS_DAYS=7

# --- Base de datos ---
POSTGRES_USER=trazo
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=trazo
# Desde tu máquina (pruebas, scripts). Dentro de docker compose, el servicio
# api usa el host "db": el compose lo sobrescribe con
# postgresql+psycopg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB>
# El esquema postgresql+psycopg:// usa psycopg 3, el driver instalado.
DATABASE_URL=postgresql+psycopg://trazo:cambia-esto@localhost:5432/trazo
# Despliegue en Supabase: usa la cadena del pooler (funciona por IPv4)
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@<pooler-host>:5432/postgres

# --- LLM (consola de la API de Claude, no la suscripción de Claude) ---
ANTHROPIC_API_KEY=
LLM_MODEL_PRIMARY=claude-haiku-4-5-20251001
LLM_MODEL_COMPARE=claude-sonnet-5
LLM_TIMEOUT_SECONDS=5
LLM_MAX_RETRIES=1
# false fuerza el camino determinístico de respaldo (reglas y plantillas)
LLM_ENABLED=true
# true en CI: usa el LLM simulado
LLM_MOCK=false

# --- Autenticación (TRZ-09) ---
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=genera-uno-largo-y-aleatorio
JWT_ALGORITHM=HS256
SESSION_IDLE_MINUTES=15
# Servicio de identidad de prueba (siempre activo en este proyecto)
OTP_TEST_MODE=true
OTP_MAX_ATTEMPTS=3
OTP_LOCK_MINUTES=15

# --- Modo demo (TRZ-09 CA3, TRZ-38) ---
# Habilita el código OTP fijo, el endpoint de reinicio y el estado sembrado.
# Siempre false en la evaluación.
DEMO_MODE=false
DEMO_OTP_CODE=482913
# Credenciales de prueba de la analista del demo
ANALYST_DEMO_USER=analista.demo
ANALYST_DEMO_PASSWORD=cambia-esto

# --- Política y autonomía ---
POLICY_PATH=config/policy.yaml
# Valor inicial del interruptor. El interruptor real vive en la base y se
# cambia sin redesplegar (TRZ-35); esta variable solo lo siembra al arrancar.
AUTOMATION_ENABLED_DEFAULT=true

# --- Correo (opcional, apagado por defecto, TRZ-33) ---
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
# Solo tu bandeja de prueba, nunca correos del dataset
EMAIL_TEST_INBOX=

# --- Retención (TRZ-41) ---
CONVERSATION_RETENTION_DAYS=90
